# Copy to server/.env and fill in. NEVER commit the real .env — it is gitignored.

# ===========================================================================
# LLM provider — set ONE of these keys. The server picks a provider from
# whichever key is present, or force it with LLM_PROVIDER.
# ===========================================================================

# Option A — OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Option B — Anthropic: https://console.anthropic.com
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5
# CLAUDE_EFFORT=low

# Force a provider when both keys are present: openai | anthropic
# LLM_PROVIDER=openai

# ===========================================================================
# Contact form email (optional).
#
# Without these the contact endpoint still accepts and stores messages, but
# nothing lands in your inbox — so set them for anything public-facing.
#
# Gmail: enable 2FA, then create an App Password (NOT your account password)
# at https://myaccount.google.com/apppasswords
# ===========================================================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Where enquiries are delivered, and what address they appear to come from.
MAIL_TO=alikhan.webdev.11@gmail.com
MAIL_FROM=

# ===========================================================================
# Server
# ===========================================================================

# Port the API listens on (Render sets this automatically)
PORT=8787

# Comma-separated origins allowed to call this API.
# Add your Vercel URL once deployed.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Where contact messages are appended as JSONL.
# NOTE: on Render's free tier the filesystem is ephemeral — this file is lost
# on every redeploy. Email is the durable delivery path.
MESSAGES_FILE=./data/messages.jsonl
